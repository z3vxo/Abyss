/* Abyss — tables styles. Loaded after core.qss; see Application::initialise(). */

QListView,
QListWidget,
QTableView,
QTableWidget {
    background-color: #12151e;
    alternate-background-color: #141821;
    color: #e3e7ee;
    border: none;
    outline: none;
    selection-background-color: #253248;
    selection-color: #ffffff;
}

QTableView,
QTableWidget {
    gridline-color: #12151e;
}

QListView::item,
QListWidget::item,
QTableView::item,
QTableWidget::item {
    padding: 7px 12px;
}

QListView::item:hover,
QListWidget::item:hover,
QTableView::item:hover,
QTableWidget::item:hover {
    background-color: #1e2431;
}

QListView::item:selected,
QListWidget::item:selected,
QTableView::item:selected,
QTableWidget::item:selected {
    background-color: #253248;
    color: #ffffff;
}

QHeaderView {
    background-color: #181d29;
}

QHeaderView::section {
    background-color: #181d29;
    color: #9ea9ba;
    border: none;
    border-bottom: 1px solid #292f3d;
    padding: 10px 12px;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #181d29;
    border: none;
    border-bottom: 1px solid #292f3d;
}
