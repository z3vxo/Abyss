/*
   Abyss — restrained SaaS surfaces, using dark.png as the palette reference.
   Window      #090b10   near-black foundation
   Panel       #12151e   elevated workspace
   Surface     #12151e   readable table, shell and input areas
   Chrome      #181d29   menus, headers and tab strip
   Border      #292f3d   quiet panel boundaries
   Accent      #7d9dcc   primary action and keyboard focus
   Text        #e3e7ee   primary / #939daf secondary
*/


QMainWindow,
QDialog {
    background-color: #090b10;
    color: #e3e7ee;
}

QWidget {
    background-color: #090b10;
    color: #e3e7ee;
    font-family: "Inter", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 13px;
}

QFrame#usersPanel,
QFrame#shellPanel {
    background-color: #12151e;
    border: none;
    border-radius: 8px;
}

QLabel {
    color: #e3e7ee;
    background: transparent;
}

QLabel:disabled {
    color: #687386;
}
